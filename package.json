{
  "name": "dsh-effort-picker",
  "version": "0.0.4",
  "private": true,
  "description": "DSH Web 客户端插件：把 composer 的思考模式（reasoning effort）换成 Codex 风格的档位滑杆（浅蓝滑轨 + 白圆钮）。TypeScript 源码 + esbuild 产物。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node tools/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "verify": "node tools/verify.ts",
    "check": "npm run typecheck && npm run build && node tools/verify.ts"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@types/node": "^24.10.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
